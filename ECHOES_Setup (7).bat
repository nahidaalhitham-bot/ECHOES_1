@echo off
title ECHOES - Setup
REM ECHOES one-file setup. Double-click once: installs to Desktop\ECHOES
REM (your data there is kept), adds an "ECHOES" icon on the Desktop and starts it.
REM No ZIP and nothing to extract.
echo.
echo  Installing ECHOES ... please wait
set "ECH_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $t=[IO.File]::ReadAllText($env:ECH_SELF); $m='::ECHOES_'+'PAYLOAD::'; $i=$t.LastIndexOf($m); $b=($t.Substring($i+$m.Length) -replace '[^A-Za-z0-9+/=]',''); $zip=Join-Path $env:TEMP 'echoes_payload.zip'; [IO.File]::WriteAllBytes($zip,[Convert]::FromBase64String($b)); $dst=Join-Path ([Environment]::GetFolderPath('Desktop')) 'ECHOES'; Expand-Archive -LiteralPath $zip -DestinationPath $dst -Force; Remove-Item $zip -Force; Get-ChildItem -LiteralPath $dst -Recurse -File | Unblock-File -ErrorAction SilentlyContinue; $sh=New-Object -ComObject WScript.Shell; $lnk=$sh.CreateShortcut((Join-Path ([Environment]::GetFolderPath('Desktop')) 'ECHOES.lnk')); $lnk.TargetPath=(Join-Path $dst 'ECHOES.bat'); $lnk.WorkingDirectory=$dst; $lnk.IconLocation='shell32.dll,13'; $lnk.Save(); Set-Content -LiteralPath (Join-Path $env:TEMP 'echoes_dir.txt') -Value $dst -Encoding ASCII; Write-Host (' Installed to: '+$dst) } catch { Write-Host (' Setup failed: '+$_.Exception.Message); exit 1 }"
if errorlevel 1 (
  pause
  exit /b 1
)
set /p ECHOES_DIR=<"%TEMP%\echoes_dir.txt"
echo.
echo  Done. From now on just open the "ECHOES" icon on your Desktop.
echo.
call "%ECHOES_DIR%\ECHOES.bat"
exit /b
